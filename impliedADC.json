{
  "kpi": "implied_average_daily_census",
  "definition": {
    "label": "Implied Average Daily Census",
    "description": "Patient Days divided by the ADC window — normalised census proxy.",
    "category": "Executive",
    "version": "1.0.0",
    "status": "Published",
    "source": "CLIENT_EPISODES_ALL",
    "aggregation": "CALC",
    "formula": "patient_days / @ADC_WINDOW_DAYS",
