# ── VM Backend Service configuration ──────────────────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env

# Port this service listens on (point ngrok at THIS port)
PORT=8080

# Shared secret. MUST match BACKEND_API_KEY in the Next.js app's environment.
API_KEY=564d52d3185ebb308731bac26cd76e84b4fe1335c3d2e4638b8a75dcc22d214d

# ── Database connection (choose ONE style) ──────────────────────────────────────

# Option A — individual variables (recommended for on-prem SQL Server)
DB_HOST=AS01AHHS
DB_PORT=1433
DB_NAME=HCHB_AcaciaHealth
DB_USER=your_sql_user
DB_PASS=your_sql_password
# Trust a self-signed server cert (typical on-prem). Set to "false" to enforce validation.
DB_TRUST_CERT=true
DB_ENCRYPT=true

# Option B — a single connection string (uncomment to use instead of DB_* above)
# DATABASE_URL=mssql://user:pass@AS01AHHS:1433/HCHB_AcaciaHealth?encrypt=true&trustServerCertificate=true
# or a classic ADO string:
# SQL_CONNECTION_STRING=Server=AS01AHHS,1433;Database=HCHB_AcaciaHealth;User Id=...;Password=...;Encrypt=true;TrustServerCertificate=true

# ── Limits ──────────────────────────────────────────────────────────────────────
MAX_ROWS=1000
QUERY_TIMEOUT_MS=30000
