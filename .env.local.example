# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ENVIRONMENT
# Copy this file to .env.local and fill in your real values.
#   cp .env.local.example .env.local
#
# .env.local is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (SQL Server / on-prem) ──────────────────────────────────────────
# Use the individual variables below (recommended).
# Your SQL Server hostname or IP — e.g. AS01AHHS or 192.168.1.50
DB_HOST=AS01AHHS
DB_PORT=1433
DB_NAME=HCHB_AcaciaHealth
DB_USER=your_sql_username
DB_PASS=your_sql_password
# On-prem SQL Server typically uses a self-signed cert — keep these as true.
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Alternative: use a single connection string instead of the DB_* vars above.
# Uncomment ONE of these and leave the DB_* vars blank if you prefer this style.
# DATABASE_URL=mssql://your_sql_username:your_sql_password@AS01AHHS:1433/HCHB_AcaciaHealth?encrypt=true&trustServerCertificate=true
# SQL_CONNECTION_STRING=Server=AS01AHHS,1433;Database=HCHB_AcaciaHealth;User Id=your_sql_username;Password=your_sql_password;Encrypt=true;TrustServerCertificate=true


# ── Auth (NextAuth + Azure AD / Microsoft Entra ID) ──────────────────────────
# NEXTAUTH_URL must be the exact URL you open in your browser locally.
NEXTAUTH_URL=http://localhost:3000
# Generate a random secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace_with_random_32_byte_hex_string

# Azure AD app registration values — find these in portal.azure.com
# App registrations → your app → Overview
AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_CLIENT_SECRET=your_client_secret_value
AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ── AI (choose one) ───────────────────────────────────────────────────────────
# Option A — Vercel AI Gateway (get key from vercel.com/dashboard → AI)
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# Option B — Azure OpenAI (leave blank if using Option A)
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name
